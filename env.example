# ─────────────────────────────────────────────────────────────────────────────
# Adashe Onchain — Environment Variables
# Copy this file to .env.local and fill in real values before running the app.
# Never commit .env.local or any file containing secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string for Prisma.
#
# Supabase: use the "Transaction pooler" (port 6543) or "Session pooler" (port 5432) URL
# from your Supabase project dashboard under Settings > Database > Connection string.
# Choose "URI" format and add ?pgbouncer=true at the end for the transaction pooler.
# Direct connection (port 5432) also works but may hit connection limits on Vercel serverless.
# Example (Supabase transaction pooler):
#   DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Example (Supabase direct connection):
#   DATABASE_URL="postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres"
#
# Vercel Postgres: set DATABASE_URL to the value of POSTGRES_PRISMA_URL from Vercel's dashboard.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/adashe?schema=public"

# ── Session ───────────────────────────────────────────────────────────────────
# 32-character random secret for iron-session cookie encryption.
# Generate: openssl rand -hex 32
SESSION_SECRET="replace-with-32-char-random-string-here"

# ── WalletConnect ─────────────────────────────────────────────────────────────
# Get a free Project ID at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="your-walletconnect-project-id"

# ── Contract ──────────────────────────────────────────────────────────────────
# AdasheCircle v6 on Arc Testnet (chain ID 5042002). Do not change.
NEXT_PUBLIC_CONTRACT_ADDRESS="0xd98f33d01cf491526d2acdb5d34ddbae49248d54"
NEXT_PUBLIC_CHAIN_ID="5042002"

# ── Arc Testnet RPC ───────────────────────────────────────────────────────────
NEXT_PUBLIC_ARC_TESTNET_RPC_URL="https://rpc.testnet.arc.io"

# ── USDC ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_USDC_ADDRESS="0x3600000000000000000000000000000000000000"

# ── App URL ───────────────────────────────────────────────────────────────────
# Used for invite links and WalletConnect metadata.
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
