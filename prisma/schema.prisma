// Prisma schema for Adashe Onchain backend
// Run: prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Vercel + Supabase integration sets these two variables automatically.
  // POSTGRES_PRISMA_URL  — pooled connection, used for all runtime queries.
  // POSTGRES_URL_NON_POOLING — direct connection, used only for prisma migrate.
  // For local dev: set both in .env (see .env.example).
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ─────────────────────────────────────────────────────────────────────────────
// Invite tokens: created by circle creators, consumed on join
// ─────────────────────────────────────────────────────────────────────────────
model Invite {
  id         String   @id @default(cuid())
  token      String   @unique
  circleId   String   // onchain circle ID (as string to avoid BigInt issues)
  createdBy  String   // creator wallet address (lowercase)
  expiresAt  DateTime
  revokedAt  DateTime?
  usedAt     DateTime?
  usedBy     String?  // wallet address that used the invite
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pinAttempts PinAttempt[]

  @@index([circleId])
  @@index([token])
}

// ─────────────────────────────────────────────────────────────────────────────
// PIN attempt tracking for rate limiting (per IP, per invite)
// ─────────────────────────────────────────────────────────────────────────────
model PinAttempt {
  id        String   @id @default(cuid())
  inviteId  String
  ipAddress String
  attemptedAt DateTime @default(now())
  succeeded Boolean  @default(false)

  invite    Invite   @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  @@index([inviteId, ipAddress])
  @@index([ipAddress, attemptedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Circle PIN hash — stored server-side, never onchain in plaintext
// ─────────────────────────────────────────────────────────────────────────────
// Keyed by (contractAddress, circleId) so circleId=1 on contract v7
// cannot collide with circleId=1 on contract v6 (both start at 1 after each deploy).
model CirclePin {
  contractAddress String   // deployed contract address, lowercase
  circleId        String   // onchain circle ID as decimal string
  pinHash         String   // bcrypt hash of PIN
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@id([contractAddress, circleId])
  @@index([contractAddress, circleId])
}

// ─────────────────────────────────────────────────────────────────────────────
// In-app notifications — created server-side for relevant contract events
// ─────────────────────────────────────────────────────────────────────────────
model Notification {
  id         String           @id @default(cuid())
  circleId   String
  wallet     String           // recipient wallet address (lowercase)
  type       NotificationType
  title      String
  body       String
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([wallet, readAt])
  @@index([circleId])
}

enum NotificationType {
  CIRCLE_ACTIVATED
  CONTRIBUTION_DUE
  DEADLINE_APPROACHING
  MISSED_PAYMENT
  PERIOD_FINALIZED
  PAYOUT_AVAILABLE
  PAYOUT_WITHHELD
  DEBT_RECORDED
  EXTENSION_REQUESTED
  EXTENSION_APPROVED
  REPLACEMENT_NEEDED
  MEMBER_APPROVED
  MEMBER_JOINED
  CIRCLE_COMPLETED
}
